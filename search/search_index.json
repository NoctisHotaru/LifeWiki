{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\-]","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Life Wiki","text":"<p>\u4e00\u4efd\u5199\u7ed9\u666e\u901a\u4eba\u7684\u751f\u6d3b\u6307\u5357\u3002\u8fd9\u91cc\u4e0d\u7ed5\u5f2f\u5b50\uff0c\u53ea\u628a\u90a3\u4e9b\u7b2c\u4e00\u6b21\u9047\u5230\u3001\u53c8\u4e0d\u77e5\u9053\u8be5\u95ee\u8c01\u7684\u4e8b\uff0c\u4e00\u6b65\u4e00\u6b65\u5199\u6e05\u695a\u3002</p>"},{"location":"#_1","title":"\u600e\u4e48\u7528\u8fd9\u4e2a\u7ad9","text":"<p>\u4e09\u4e2a\u5c0f\u63d0\u793a</p> <ul> <li>\u5de6\u4fa7\u5bfc\u822a\uff1a\u6309\u4e3b\u9898\u5c42\u5c42\u5c55\u5f00\uff0c\u70b9\u4e00\u4e0b\u5c31\u80fd\u8fdb\u5bf9\u5e94\u6587\u7ae0\u3002</li> <li>\u9876\u90e8\u641c\u7d22\uff1a\u76f4\u63a5\u8f93\u5165\u5173\u952e\u8bcd\uff0c\u6bd4\u5982\u300c\u503c\u673a\u300d\u300c\u9a8c\u5149\u300d\u300c\u52a9\u5b66\u91d1\u300d\uff0c\u5168\u6587\u90fd\u80fd\u641c\u5230\u3002</li> <li>\u53f3\u4e0a\u89d2\u6309\u94ae\uff1a\u53ef\u4ee5\u5728\u6d45\u8272\u3001\u6df1\u8272\u4e4b\u95f4\u5207\u6362\uff1b\u9ed8\u8ba4\u8ddf\u968f\u4f60\u624b\u673a\u6216\u7535\u8111\u7684\u65e5\u591c\u8bbe\u7f6e\u3002</li> </ul>"},{"location":"#_2","title":"\u5173\u4e8e\u5185\u5bb9","text":"<p>\u8bf7\u4ee5\u5b98\u65b9\u4fe1\u606f\u4e3a\u51c6</p> <p>\u672c\u7ad9\u5185\u5bb9\u4e3a\u7ecf\u9a8c\u6574\u7406\uff0c\u7968\u4ef7\u3001\u653f\u7b56\u3001\u529e\u7406\u6d41\u7a0b\u90fd\u4f1a\u53d8\u52a8\u3002\u6d89\u53ca\u91d1\u989d\u3001\u8bc1\u4ef6\u3001\u8865\u8d34\u3001\u6551\u52a9\u7b49\u5173\u952e\u4e8b\u9879\u65f6\uff0c\u8bf7\u52a1\u5fc5\u4ee5\u5b98\u65b9\u6e20\u9053\uff08\u8f66\u7ad9\u516c\u544a\u3001\u822a\u7a7a\u516c\u53f8\u5b98\u7f51\u3001\u5b66\u6821\u8d44\u52a9\u4e2d\u5fc3\u3001\u5f53\u5730\u6c11\u653f\u90e8\u95e8\uff09\u7684\u6700\u65b0\u4fe1\u606f\u4e3a\u51c6\u3002</p> <ul> <li>\u672c\u7ad9\u7eaf\u9759\u6001\uff1a\u6ca1\u6709\u8d26\u53f7\u3001\u4e0d\u9700\u8981\u6ce8\u518c\